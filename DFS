#include <iostream>
using namespace std;

int graph[10][10] = {0};
int visited[10] = {0};

void DFS(int current, int n)
{
    cout << current << " ";
    visited[current] = 1;

    for(int i = 0; i < n; i++)
    {
        if(graph[current][i] == 1 && visited[i] == 0)
        {
            DFS(i, n);
        }
    }
}

int main()
{
    int n, e;

    cout << "Enter vertices: ";
    cin >> n;

    cout << "Enter edges: ";
    cin >> e;

    cout << "Enter edges:\n";

    for(int i = 0; i < e; i++)
    {
        int a, b;
        cin >> a >> b;

        graph[a][b] = 1;
        graph[b][a] = 1;
    }

    cout << "DFS: ";

    DFS(0, n);

    return 0;
}
