# Bubble Sort in Python

n = int(input("Enter number of elements: 5"))

arr = []

print("Enter elements:")
for i in range(n):
arr.append(int(input()))


for i in range(n - 1):
 for j in range(n - i - 1):
  if arr[j] > arr[j + 1]:
      temp = arr[j]
arr[j] = arr[j + 1]
 arr[j + 1] = temp

print("Sorted array:", end=" ")
for i in range(n):
    print(arr[i], end=" ")
