#include <iostream>
using namespace std;

int main()
{
    int p[] = {10, 20, 30, 40};
    int n = 3;

    int m[10][10];

    for (int i = 1; i <= n; i++)
        m[i][i] = 0;

    for (int length = 2; length <= n; length++)
    {
        for (int i = 1; i <= n - length + 1; i++)
        {
            int j = i + length - 1;
            m[i][j] = 999999;

            for (int k = i; k < j; k++)
            {
                int cost = m[i][k] + m[k + 1][j]
                         + p[i - 1] * p[k] * p[j];

                if (cost < m[i][j])
                    m[i][j] = cost;
            }
        }
    }

    cout << "Minimum number of multiplications = "
         << m[1][n];

    return 0;
}
