#include <iostream>
using namespace std;

int main()
{
    int n;
    cout << "Enter number of matrices: ";
    cin >> n;

    int p[10];

    cout << "Enter dimensions: ";
    for(int i = 0; i <= n; i++)
        cin >> p[i];

    int dp[10][10] = {0};

    for(int l = 2; l <= n; l++)
    {
        for(int i = 1; i <= n-l+1; i++)
        {
            int j = i+l-1;
            dp[i][j] = 999999;

            for(int k = i; k < j; k++)
            {
                int cost = dp[i][k] + dp[k+1][j]
                         + p[i-1] * p[k] * p[j];

                if(cost < dp[i][j])
                    dp[i][j] = cost;
            }
        }
    }

    cout << "Minimum cost = " << dp[1][n];

    return 0;
}
